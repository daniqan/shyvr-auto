    async def test_real_time_market_data_feed(self, complete_simulation_setup):
        """Test real-time market data integration."""
        simulation_mode = complete_simulation_setup["simulation_mode"]
        
        await simulation_mode.initialize()
        await simulation_mode.start()
        
        # Should have active market data feed
        assert simulation_mode.market_data_feed.is_active
        
        # Should receive and process market updates
        market_update = {
            "BTC_ADDRESS": {
                "price": Decimal("105000"),
                "volume_24h": Decimal("2000000"),
                "timestamp": datetime.now()
            }
        }
        
        await simulation_mode.process_market_update(market_update)
        
        # Should update virtual portfolio prices
        positions = simulation_mode.virtual_portfolio.positions
        if positions:
            for position in positions.values():
                assert position.updated_at is not None
    
    async def test_performance_monitoring_integration(self, complete_simulation_setup):
        """Test integration with performance monitoring."""
        simulation_mode = complete_simulation_setup["simulation_mode"]
        
        await simulation_mode.initialize()
        await simulation_mode.start()
        
        # Generate some trading activity
        from src.discovery.base import DiscoveredToken
        mock_token = DiscoveredToken(
            token_address="TEST_TOKEN_123",
            name="Test Token",
            symbol="TEST",
            chain="solana", 
            token_age_hours=24,
            creator_balance_pct=5.0,
            top_10_holder_balance_pct=15.0,
            is_honeypot=False,
            is_renounced=True,
            has_trading_enabled=True
        )
        
        for _ in range(5):
            market_state = MarketState(
                token=mock_token,
                price_usd=100.0,
                price_change_24h=5.0,
                volume_24h=1000000.0,
                rsi=30.0
            )
            await simulation_mode.process_tick(market_state)
            await asyncio.sleep(0.01)  # Brief pause
        
        # Should track performance metrics
        metrics = simulation_mode.simulation_metrics
        assert metrics.total_trades >= 0
        assert hasattr(metrics, 'execution_latency_ms')
        assert hasattr(metrics, 'average_slippage_bps')
        
        # Should generate performance report
        report = await simulation_mode.generate_performance_report()
        assert 'total_trades' in report
        assert 'win_rate' in report
        assert 'profit_factor' in report