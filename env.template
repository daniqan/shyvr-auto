# Shyvr RLTE Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real API keys

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/shyvr_rlte"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="shyvr_rlte"
DB_USER="your_username"
DB_PASSWORD="your_password"

# API Keys - Replace with your actual keys
TELEGRAM_TOKEN="your_telegram_bot_token"
WEBHOOK_SECRET="your_webhook_secret"

# Trading API Keys
HELIUS_API_KEY="your_helius_api_key"
BIRDEYE_API_KEY="your_birdeye_api_key"
JUPITER_API_KEY="your_jupiter_api_key"
ETHERSCAN_API_KEY="your_etherscan_api_key"

# AI/ML API Keys
OPENAI_API_KEY="your_openai_api_key"
XAI_API_KEY="your_xai_api_key"
AGENT_API_KEY="your_agent_api_key"

# Market Data API Keys
LUNARCRUSH_API_KEY="your_lunarcrush_api_key"
COINGECKO_API_KEY="your_coingecko_api_key"

# Trading Configuration
TRADING_MODE="analysis"  # analysis, simulation, or live
MAX_POSITION_SIZE="0.01"
RISK_LEVEL="conservative"

# Security Configuration (DO NOT COMMIT REAL KEYS)
SOLANA_PRIVATE_KEY="your_solana_private_key_base58"
ETHEREUM_PRIVATE_KEY="your_ethereum_private_key_hex"

# Application Configuration
ENVIRONMENT="development"
DEBUG="true"
LOG_LEVEL="INFO"
PORT="8080"

# Google Cloud Configuration
GCP_PROJECT_ID="your_gcp_project_id"
GCP_REGION="us-central1"