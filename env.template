# =============================================================================
# Production Environment Configuration Template
# =============================================================================
# Copy this file to .env.production and fill in the actual values
# NEVER commit the actual .env.production file to version control

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=production
VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-here-min-32-chars
JWT_SECRET=your-jwt-secret-key-here-min-32-chars
ENCRYPTION_KEY=your-encryption-key-here

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL Configuration
POSTGRES_DB=shyvr_rlte
POSTGRES_USER=rlte_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL (for application)
DATABASE_URL=postgresql://rlte_user:your-secure-postgres-password@postgres:5432/shyvr_rlte

# Connection pooling
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=your-redis-password

# =============================================================================
# Monitoring & Observability
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=8080
PROMETHEUS_URL=http://prometheus:9090

# Grafana
GRAFANA_PASSWORD=your-secure-grafana-password

# =============================================================================
# External API Keys & Services
# =============================================================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Hyperliquid
HYPERLIQUID_API_KEY=your-hyperliquid-api-key
HYPERLIQUID_SECRET=your-hyperliquid-secret

# Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your-solana-private-key

# Ethereum
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Birdeye API
BIRDEYE_API_KEY=your-birdeye-api-key

# =============================================================================
# Trading Configuration
# =============================================================================
# Risk Management
MAX_POSITION_SIZE_PCT=0.1
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15

# Trading Modes
TRADING_MODE=simulation  # simulation, live, analysis
ENABLE_PAPER_TRADING=true

# =============================================================================
# ML/RL Configuration
# =============================================================================
# Model paths (should be mounted volumes in production)
MODEL_PATH=/app/models
CACHE_PATH=/app/cache

# Training parameters
BATCH_SIZE=32
LEARNING_RATE=0.001
REPLAY_BUFFER_SIZE=100000

# =============================================================================
# Google Cloud Configuration (if using GCP services)
# =============================================================================
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# Cloud SQL (if using managed PostgreSQL)
CLOUD_SQL_CONNECTION_NAME=your-project:region:instance

# =============================================================================
# Telegram Bot (for notifications)
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# =============================================================================
# Storage Configuration
# =============================================================================
# Data directories (should be mounted volumes)
DATA_DIR=./data
LOGS_DIR=./logs
MODELS_DIR=./models
POSTGRES_DATA_DIR=./postgres-data

# =============================================================================
# Network & Performance
# =============================================================================
# FastAPI/Uvicorn
WORKERS=1
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT_KEEP_ALIVE=5

# CORS (adjust for your frontend domain)
ALLOWED_ORIGINS=https://your-domain.com,https://api.your-domain.com
ALLOWED_HOSTS=your-domain.com,api.your-domain.com

# =============================================================================
# SSL/TLS Configuration (for production with reverse proxy)
# =============================================================================
SSL_CERT_PATH=/app/certs/cert.pem
SSL_KEY_PATH=/app/certs/key.pem

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups

# =============================================================================
# Alert Configuration
# =============================================================================
ALERT_EMAIL=alerts@your-domain.com
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=your-smtp-password

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# =============================================================================
# Development Overrides (only for staging)
# =============================================================================
# Uncomment these only for staging environment
# DEBUG=true
# LOG_LEVEL=DEBUG
# ENABLE_SWAGGER=true