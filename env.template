# =============================================================================
# Shyvr RLTE Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real values to version control

# =============================================================================
# Security Configuration (REQUIRED)
# =============================================================================
SECRET_KEY=your_secret_key_here_minimum_32_chars
JWT_SECRET=your_jwt_secret_here_minimum_32_chars

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
DATABASE_URL=postgresql://username:password@host:port/database
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_USER=your_postgres_username
POSTGRES_DB=shyvr_rlte

# Alternative database configuration (if not using DATABASE_URL)
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=shyvr_rlte
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# =============================================================================
# Monitoring & Observability (REQUIRED)
# =============================================================================
GRAFANA_PASSWORD=your_secure_grafana_admin_password
GRAFANA_DASHBOARD_URL=http://your-grafana-host:3000
GRAFANA_API_KEY=your_grafana_api_key
GRAFANA_ORG=Main Org.

# =============================================================================
# Development Tools (OPTIONAL - only for local development)
# =============================================================================
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your_pgadmin_password

# =============================================================================
# API Keys (OPTIONAL - required for trading functionality)
# =============================================================================
HELIUS_API_KEY=your_helius_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
BIRDEYE_API_KEY=your_birdeye_api_key
X_BEARER_TOKEN=your_x_bearer_token
TELEGRAM_TOKEN=your_telegram_bot_token

# =============================================================================
# Agent Configuration (OPTIONAL)
# =============================================================================
AGENT_MODEL_TYPE=local
AGENT_MODEL_NAME=local-mock
AGENT_API_KEY=your_agent_api_key

# =============================================================================
# Production Configuration (OPTIONAL)
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data
LOGS_DIR=./logs
MODELS_DIR=./models
POSTGRES_DATA_DIR=./postgres-data

# =============================================================================
# Docker Build Configuration (OPTIONAL)
# =============================================================================
VERSION=latest