# Google Cloud Build ignore file
# Excludes files and directories from uploads to Cloud Build

# Build artifacts and cache
.git
.gitignore
*.pyc
*.pyo
*.pyd
__pycache__
.pytest_cache
.coverage
htmlcov/
.cache/
*.log
.DS_Store

# Development files
.env
.env.local
.env.development
.env.test
.vscode/
.idea/
*.swp
*.swo
*~

# Test and coverage files
coverage.xml
pytest-results.xml
benchmark-results.json
*.sarif

# Documentation (not needed for builds)
docs/
hist/
*.md
README.md

# Model files and large data
models/
data/
performance_results/
static/

# Development dependencies
.tox/
.mypy_cache/
.ruff_cache/
.black_cache/
.isort_cache/

# OS files
.DS_Store
Thumbs.db

# IDE files
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
.tmp/