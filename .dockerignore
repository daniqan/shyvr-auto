.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Environment and secrets
.env*
!.env.example
secrets/
*.key
*.pem
*.crt
*.cert

# Local configuration overrides
config/local.yaml
config/development.yaml
config/test.yaml
!config/config.yaml

# Scripts and utilities (most not needed in production)
scripts/
!scripts/production_*.py

# Static files that aren't core to the app
static/test.html
static/**/*.test.js

# Large data files
data/
datasets/
*.csv
*.json
!config/*.json
*.parquet
*.h5
*.hdf5

