# =============================================================================
# Dockerignore for Shyvr RLTE - Production Optimized
# =============================================================================

# Development and testing files
.git/
.gitignore
.github/
**/.pytest_cache/
**/htmlcov/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.cover
*.coverage
.coverage.*
coverage.xml
.tox/
.cache
nosetests.xml
pytest.ini

# Development tools and configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation (exclude from production builds)
docs/
*.md
!README.md
TODO_CHECKLIST.md
hist/
htmlcov/

# Local development files
.env
.env.local
.env.*.local
*.log
logs/
**/.logs/

# Build artifacts and temporary files
build/
dist/
*.egg-info/
.eggs/
.build/
.cache/
tmp/
temp/
**/.tmp/

# Package management (uv.lock is needed, pyproject.toml is needed)
.pip-cache/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files (should be external)
*.db
*.sqlite
*.sqlite3
database/*.sql
database/migrations/
!database/migrations/001_create_initial_schema.sql

# Model artifacts (should be loaded from external storage)
models/
*.pkl
*.pt
*.pth
*.h5
*.model
*.safetensors
*.bin
performance_results/
reports/

# Transformer model development artifacts
models/cache/temp
transformers_cache/
.cache/
huggingface/
torch_cache/
model_cache/

# Development transformer models (not for production)
*.transformer
*.attention
dev_models/
test_models/

# Monitoring and operational files
monitoring/grafana/
monitoring/prometheus/
**/.prometheus/

# Testing infrastructure
tests/
**/test_*.py
**/*_test.py
conftest.py
pytest.ini

# Examples and demos
examples/
demo/
samples/

# Future work and planning
future_work/
planning/

# CI/CD files (handled separately)
.github/
.gitlab-ci.yml
.travis.yml
circle.yml
Jenkinsfile
cloudbuild.yaml
deploy/

# Container-specific ignores
Dockerfile*
docker-compose*.yml
.dockerignore*

# Backup and archive files
*.bak
*.backup
*.tar
*.tar.gz
*.zip
*.rar
*.7z

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor backup files
*~
.#*
#*#
.#*
*.swp
*.swo
*.tmp

