.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store*
ehthumbs.db
Icon?
Thumbs.db
*.tmp

# Security scan results
.snyk
security/

# Performance profiling
*.prof
*.profile
profiling/

# Helm charts and k8s configs (handled separately)
charts/
k8s/
kubernetes/

# Terraform and infrastructure
terraform/
*.tfstate
*.tfstate.backup
.terraform/

# Local overrides for any config
local_*
*_local.*