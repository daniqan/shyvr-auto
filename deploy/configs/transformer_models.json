{
  "ensemble": {
    "models": ["lstm", "iTransformer", "PatchTST", "TimesMixer", "TimesFM"],
    "resources": {
      "memory": "8Gi",
      "cpu": 6,
      "scaling_factor": 1.5,
      "max_concurrent_requests": 8,
      "startup_cpu_boost": true
    },
    "health_checks": {
      "endpoint": "/health/ensemble",
      "timeout_seconds": 45,
      "interval_seconds": 20,
      "max_failures": 3,
      "startup_probe_delay": 90
    },
    "timeouts": {
      "request_timeout": 180,
      "startup_timeout": 300,
      "shutdown_timeout": 60
    },
    "environment": {
      "variables": {
        "MODEL_TYPE": "ensemble",
        "ENSEMBLE_MODELS": "lstm,iTransformer,PatchTST,TimesMixer,TimesFM",
        "ENSEMBLE_MODE": "true",
        "MODEL_CACHE_DIR": "/app/models/cache",
        "ENSEMBLE_BATCH_SIZE": "1"
      }
    }
  },
  "_metadata": {
    "version": "1.0.0",
    "created_by": "transformer_rollout_config_generator",
    "created_at": "2025-08-06",
    "phase": "3.3.3",
    "description": "Transformer model configuration for Cloud Run deployment",
    "compatibility": {
      "blue_green_deployment": ">=1.0",
      "cloud_run": ">=gen2",
      "phase_326_optimizations": true
    },
    "validation": {
      "schema_version": "1.0",
      "required_fields": ["resources", "health_checks", "timeouts", "environment"],
      "resource_validation": true
    }
  }
}