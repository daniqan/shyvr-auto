{
  "dashboard": {
    "id": null,
    "title": "Shyvr RLTE Trading Bot Monitoring",
    "tags": ["trading", "crypto", "rl"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Trading Performance",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "trading_total_pnl{currency=\"USD\"}",
            "refId": "A",
            "legendFormat": "Total P&L (USD)"
          },
          {
            "expr": "trading_daily_pnl{currency=\"USD\"}",
            "refId": "B",
            "legendFormat": "Daily P&L (USD)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        }
      },
      {
        "id": 2,
        "title": "Trading Volume & Count",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(trading_volume_total[5m]) * 300",
            "refId": "A",
            "legendFormat": "Volume/5min"
          },
          {
            "expr": "rate(trading_trade_count_total[5m]) * 300",
            "refId": "B",
            "legendFormat": "Trades/5min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1
          }
        }
      },
      {
        "id": 3,
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "trading_success_rate{symbol=\"ALL\"}",
            "refId": "A",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 0.7}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Risk Level",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 8
        },
        "targets": [
          {
            "expr": "safety_risk_level{risk_type=\"overall\"}",
            "refId": "A",
            "legendFormat": "Overall Risk"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "orange", "value": 0.7},
                {"color": "red", "value": 0.9}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Active Positions",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 8
        },
        "targets": [
          {
            "expr": "trading_position_count{symbol=\"ALL\"}",
            "refId": "A",
            "legendFormat": "Active Positions"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 6,
        "title": "Trading Volume Over Time",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "rate(trading_volume_total[1m]) * 60",
            "refId": "A",
            "legendFormat": "Volume/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 0.1
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Safety Events",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "expr": "rate(safety_emergency_stops_total[5m]) * 300",
            "refId": "A",
            "legendFormat": "Emergency Stops"
          },
          {
            "expr": "rate(safety_liquidations_total[5m]) * 300",
            "refId": "B",
            "legendFormat": "Liquidations"
          },
          {
            "expr": "rate(safety_risk_violations_total[5m]) * 300",
            "refId": "C",
            "legendFormat": "Risk Violations"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Emergency Stops"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            },
            {
              "matcher": {"id": "byName", "options": "Liquidations"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
            }
          ]
        }
      },
      {
        "id": 8,
        "title": "Drawdown",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "targets": [
          {
            "expr": "safety_drawdown_percentage{timeframe=\"daily\"}",
            "refId": "A",
            "legendFormat": "Daily Drawdown"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "fillOpacity": 0.2
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 20}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Trade Size Distribution",
        "type": "histogram",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "expr": "trading_trade_size_seconds",
            "refId": "A",
            "legendFormat": "Trade Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 10,
        "title": "Trade Duration Distribution",
        "type": "histogram",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        },
        "targets": [
          {
            "expr": "trading_trade_duration_seconds",
            "refId": "A",
            "legendFormat": "Trade Duration"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(up, instance)",
          "refresh": 1,
          "includeAll": false,
          "multi": false
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Emergency Stops",
          "datasource": "prometheus",
          "enable": true,
          "expr": "increase(safety_emergency_stops_total[1m]) > 0",
          "titleFormat": "Emergency Stop",
          "textFormat": "{{reason}} - {{trigger}}",
          "tagsField": "reason",
          "iconColor": "red"
        }
      ]
    }
  }
}